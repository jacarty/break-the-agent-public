# Inputs for infra/bootstrap, which is applied from an operator's laptop rather
# than from CI — see README.md §"Why this module is not automated".
#
# Copy to .env.local (gitignored) and fill in. Every value is a placeholder;
# none of them is a deployment value (POR-6). Nothing here is a credential —
# these name a project, a repository and a bucket. Authentication is your own
# `gcloud auth login`.
#
#     cp .env.local.example .env.local
#     $EDITOR .env.local
#     source .env.local
#
# The file exists because this module is re-run whenever CI's authority
# changes, and reconstructing eight exports from memory each time is how a
# wrong value reaches a trust condition.

export TF_VAR_project_id="your-project-id"
export TF_VAR_region="your-region"
export TF_VAR_state_bucket_name="your-project-id-tfstate"   # globally unique
export TF_VAR_state_bucket_location="your-bucket-location"

# The image repository (registry.tf). Required, no default — it was missing
# from this file, so a `source`d shell left Terraform prompting for it
# interactively, which is the one input this file exists to stop being typed
# from memory.
export TF_VAR_registry_id="bta-arena"

# Only needed if hosting's `service_name` is overridden. It names the Identity
# Platform browser key, which lives in this module because its destroy is
# irreversible for 30 days (identity_platform_key.tf). Defaults to bta-arena in
# both modules; if you change one, change both.
# export TF_VAR_arena_service_name="bta-arena"

# Checked together by the provider's attribute condition. The owner ID is the
# numeric account ID, not the login: repository names are reusable after a
# rename, transfer or deletion, and account IDs are not.
#
#     gh api users/your-org --jq .id
export TF_VAR_github_repository="your-org/your-repo"
export TF_VAR_github_owner_id="00000000"

# Both start false on a new project and are turned on in that order, each with
# its own plan/apply. See README.md §"Granting access".
export TF_VAR_grant_ci_state_access=false
export TF_VAR_enable_ci_deploy_identity=false

# Extra refs allowed to impersonate the deploy identity, for testing a change to
# a workflow without merging it first. Reachable on dispatch only — the jobs
# that authenticate as the deploy identity are gated on workflow_dispatch, and a
# pull_request run carries refs/pull/N/merge, which matches nothing here.
#
# Empty is the correct state whenever you are not actively testing a workflow.
# A standing grant to a branch that has long since merged is authority nobody is
# thinking about (TD-2).
#
# Name one working branch, as a full ref. Wildcards are refused: attribute.ref
# is matched exactly, so a pattern grants access to nobody while looking like it
# grants access to everybody.
#
#     export TF_VAR_ci_additional_privileged_refs='["refs/heads/your-branch"]'
export TF_VAR_ci_additional_privileged_refs='[]'
